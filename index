<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>Muhsina, 11:11</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500;1,700&display=swap">
<style>
:root{
  --night:#0b0a1f;--ink:#fbf3ff;--soft:#d6c6ea;--gold:#ffd27a;--glow:rgba(255,210,122,.5);--glass:rgba(14,10,36,.5);
  color-scheme:dark;box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0}
*{box-sizing:border-box}
body{background:var(--night);color:var(--ink);font-family:'Cormorant Garamond',Georgia,serif;text-align:center;overflow:hidden}
#bg{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 46%}
#veil{position:fixed;inset:0;background:linear-gradient(180deg,rgba(8,6,25,.82) 0%,rgba(8,6,25,.2) 30%,rgba(8,6,25,.05) 50%,rgba(8,6,25,.55) 72%,rgba(8,6,25,.92) 100%)}
#sky{position:fixed;inset:0;pointer-events:none}
#sky i{position:absolute;width:3px;height:3px;border-radius:50%;background:#fff3d1;opacity:.55;animation:tw 3.2s ease-in-out infinite}
@keyframes tw{50%{opacity:.05;transform:scale(.5)}}
main{position:relative;height:100%;max-width:480px;margin:0 auto;padding:22px 18px 22px;display:flex;flex-direction:column;justify-content:space-between}
.date{font-size:1.05rem;letter-spacing:.12em;color:var(--soft);font-family:'Cormorant Garamond',Georgia,serif;font-weight:500}
h1{font-size:clamp(4.4rem,23vw,6.6rem);line-height:1;margin:.05em 0 0;font-weight:700;color:var(--gold);letter-spacing:.04em;text-shadow:0 0 30px var(--glow);animation:pulse 4s ease-in-out infinite}
@keyframes pulse{50%{text-shadow:0 0 60px var(--glow),0 0 12px var(--glow)}}
.name{font-size:clamp(2.4rem,12vw,3.4rem);font-style:italic;font-weight:700;margin-top:.05em;text-shadow:0 2px 18px rgba(0,0,0,.6)}
.clock{font-family:system-ui,sans-serif;font-size:.8rem;color:var(--soft);margin-top:6px;min-height:1.3em}
body.magic .clock{color:var(--gold);font-weight:700}
#card{background:var(--glass);border:1px solid rgba(255,255,255,.16);border-radius:16px;padding:16px 18px;min-height:84px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;line-height:1.3;font-style:italic;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:opacity .3s}
#stars{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:320px;margin:14px auto 0}
.star{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.4);background:var(--glass);color:var(--ink);font:700 1.05rem 'Cormorant Garamond',Georgia,serif;cursor:pointer;transition:.25s;-webkit-tap-highlight-color:transparent}
.star:focus-visible,#wish:focus-visible,#back:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.star.on{background:var(--gold);color:var(--night);border-color:var(--gold);box-shadow:0 0 16px var(--glow)}
.star.cur{transform:scale(1.15)}
#count{font-family:system-ui,sans-serif;font-size:.75rem;color:var(--soft);margin:10px 0 0}
#final{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(8,6,25,.8);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);z-index:4}
#final.show{display:flex;animation:fade 1s ease}
@keyframes fade{from{opacity:0}}
#final p{font-size:1.9rem;font-style:italic;line-height:1.3;margin:0 0 22px}
#final b{color:var(--gold)}
button.go{border:0;border-radius:999px;padding:14px 30px;background:var(--gold);color:var(--night);font:700 1.2rem 'Cormorant Garamond',Georgia,serif;cursor:pointer;box-shadow:0 0 24px var(--glow)}
button.ghost{display:block;margin:16px auto 0;background:none;border:0;color:var(--soft);font:500 1rem 'Cormorant Garamond',Georgia,serif;text-decoration:underline;cursor:pointer}
.fly{position:fixed;bottom:-20px;z-index:6;pointer-events:none;color:var(--gold);animation:up 2.6s ease-out forwards}
@keyframes up{to{transform:translateY(-105vh) rotate(40deg);opacity:0}}
#bg{animation:reveal 3.4s ease-out both,kb 45s ease-in-out 3.4s infinite alternate}
@keyframes reveal{from{opacity:0;transform:scale(1.14);filter:blur(12px)}}
@keyframes kb{to{transform:scale(1.06)}}
@keyframes rise{from{opacity:0;transform:translateY(12px)}}
header{animation:rise 2s ease .9s both}
footer{animation:rise 2s ease 2.4s both}
#con{display:block;width:min(230px,60vw);height:auto;margin:8px auto 0;overflow:visible;touch-action:manipulation;transform-origin:50% 50%}
#con.beat{animation:beat 2.6s ease-in-out infinite}
@keyframes beat{50%{transform:scale(1.04)}}
.st{cursor:pointer}
.st .core{fill:#fff;opacity:.5;animation:tw 3s ease-in-out infinite}
.st.next .core{opacity:1;animation:none}
.st.on .core{fill:var(--gold);opacity:1;animation:none;filter:drop-shadow(0 0 3px var(--gold))}
.st .rg{fill:none;stroke:var(--gold);stroke-width:.8;opacity:0;transform-box:fill-box;transform-origin:center}
.st.next .rg{animation:pr 1.7s ease-out infinite}
@keyframes pr{from{transform:scale(1);opacity:.9}to{transform:scale(3.4);opacity:0}}
.seg{stroke:var(--gold);stroke-width:1;stroke-linecap:round;transition:stroke-dashoffset .9s ease;filter:drop-shadow(0 0 2px rgba(255,210,122,.85))}
.hfill{fill:rgba(255,210,122,0);transition:fill 1.8s ease;pointer-events:none}
.hfill.lit{fill:rgba(255,210,122,.17)}
#shoot{position:fixed;z-index:5;top:12%;left:-30%;width:160px;height:2px;pointer-events:none;opacity:0;background:linear-gradient(90deg,transparent,#fff);box-shadow:0 0 12px #fff}
#shoot.go{animation:shoot 1.9s ease-out forwards}
@keyframes shoot{0%{opacity:0;transform:translate(0,0) rotate(18deg)}12%{opacity:1}100%{opacity:0;transform:translate(150vw,34vh) rotate(18deg)}}
@media (prefers-reduced-motion: reduce){h1,#sky i,.fly,#bg,header,footer,#con,.st .core,.st .rg,#shoot{animation:none!important}.seg,.hfill{transition:none}}
</style>
</head>
<body>
<img id="bg" src="data:image/jpeg;base64," alt="Suhail and Muhsina">
<div id="veil"></div>
<div id="sky"></div>
<main>
  <header>
    <div class="date">November 11</div>
    <h1>11:11</h1>
    <div class="name">Muhsina</div>
    <div class="clock" id="clock"></div>
  </header>
  <footer>
    <div id="card">Touch the glowing star ✦</div>
    <svg id="con" viewBox="0 0 120 100" role="group" aria-label="Eleven stars that form a heart"></svg>
    <p id="count">0 of 11</p>
  </footer>
</main>
<div id="final">
  <div>
    <p>Muhsina,<br>close your eyes and make a wish.<br><b>I’m wishing for you, always.</b></p>
    <button class="go" id="wish">Make a wish ✦</button>
    <button class="ghost" id="back">Back to us</button>
  </div>
</div>
<div id="shoot"></div>
<script>
const reasons=[
"You make ordinary days feel like something to look forward to.",
"Your smile is my favorite sight in the world.",
"You’re the first person I want to tell everything.",
"Distance is only kilometers. You’re still my closest person.",
"You believe in me on the days I forget to.",
"Even in silence, being with you feels like home.",
"You turn small moments into stories worth keeping.",
"I love how you care, quietly and completely.",
"Every plan I make for the future has you in it.",
"You’re the best part of my day, near or far.",
"And at 11:11, my wish is always the same: you."
];
const sky=document.getElementById('sky');
for(let i=0;i<28;i++){const s=document.createElement('i');
  s.style.left=Math.random()*100+'%';s.style.top=Math.random()*100+'%';
  s.style.animationDelay=(Math.random()*3)+'s';sky.appendChild(s);}
const card=document.getElementById('card'),count=document.getElementById('count'),fin=document.getElementById('final'),
  svg=document.getElementById('con'),NS='http://www.w3.org/2000/svg';
const P=[[60,92],[32,66],[14,42],[16,20],[36,8],[60,26],[84,8],[104,20],[106,42],[88,66],[60,48]];
const mk=(n,a,p)=>{const e=document.createElementNS(NS,n);for(const k in a)e.setAttribute(k,a[k]);(p||svg).appendChild(e);return e;};
const fill=mk('path',{d:'M'+P.slice(0,10).map(p=>p.join(' ')).join('L')+'Z',class:'hfill'});
const segs=[];
for(let i=1;i<=10;i++){const a=P[i-1],b=P[i%10],len=Math.hypot(a[0]-b[0],a[1]-b[1]);
  segs[i]=mk('line',{x1:a[0],y1:a[1],x2:b[0],y2:b[1],class:'seg'});
  segs[i].style.strokeDasharray=len;segs[i].style.strokeDashoffset=len;}
let nxt=0;
const stars=P.map((p,i)=>{const g=mk('g',{class:'st'});
  mk('circle',{cx:p[0],cy:p[1],r:3,class:'rg'},g);
  const c=mk('circle',{cx:p[0],cy:p[1],r:2,class:'core'},g);c.style.animationDelay=(i*.35)+'s';
  mk('circle',{cx:p[0],cy:p[1],r:9,fill:'transparent'},g);
  g.addEventListener('click',()=>pick(i));return g;});
stars[0].classList.add('next');
function show(i){card.style.opacity=0;setTimeout(()=>{card.textContent=reasons[i];card.style.opacity=1;},160);}
function done(){
  fill.classList.add('lit');svg.classList.add('beat');
  const s=document.getElementById('shoot');s.classList.remove('go');void s.offsetWidth;s.classList.add('go');
  setTimeout(()=>fin.classList.add('show'),2600);
}
function pick(i){
  if(i>nxt)return;
  show(i);
  if(i<nxt)return;
  stars[i].classList.remove('next');stars[i].classList.add('on');
  if(i>=1&&i<=9)segs[i].style.strokeDashoffset=0;
  if(i===9){segs[10].style.transitionDelay='.9s';segs[10].style.strokeDashoffset=0;}
  nxt=i+1;count.textContent=nxt+' of 11';
  if(nxt<11)stars[nxt].classList.add('next');else done();
}
function burst(){
  for(let i=0;i<28;i++){const f=document.createElement('span');f.className='fly';
    f.textContent=Math.random()>.4?'✦':'♥';f.style.left=Math.random()*100+'%';
    f.style.fontSize=(14+Math.random()*22)+'px';f.style.animationDelay=(Math.random()*.8)+'s';
    document.body.appendChild(f);setTimeout(()=>f.remove(),3600);}
}
document.getElementById('wish').onclick=burst;
document.getElementById('back').onclick=()=>fin.classList.remove('show');
const clock=document.getElementById('clock');
function tick(){
  const d=new Date(),h=d.getHours()%12||12,m=d.getMinutes(),magic=h===11&&m===11;
  clock.textContent=magic?'It’s 11:11 right now. Make a wish.':
    d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})+' where you are';
  document.body.classList.toggle('magic',magic);
}
tick();setInterval(tick,1000);
</script>
</body>
</html>
